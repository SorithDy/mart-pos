# MongoDB Atlas connection string.
# Replace the username, password, cluster host, and database name.
MONGO_URL=mongodb+srv://<username>:<url-encoded-password>@<cluster>.mongodb.net/Mart_POS?retryWrites=true&w=majority&appName=Cluster01
# Optional: comma-separated DNS servers for Atlas SRV lookup.
DNS_SERVERS=1.1.1.1,8.8.8.8
# Optional: comma-separated frontend origins for CORS and Socket.io.
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
# Optional: backend port.
PORT=3000

# Real ABA / Bakong KHQR merchant setup
KHQR_BAKONG_ACCOUNT=your-merchant-account@abakong
KHQR_MERCHANT_NAME=Your Mart Name
KHQR_MERCHANT_CITY=PHNOM PENH
KHQR_MERCHANT_ID=YOUR_MERCHANT_ID
KHQR_ACQUIRING_BANK=Advanced Bank of Asia Limited Cambodia
KHQR_STORE_LABEL=Mart Dashboard
KHQR_TERMINAL_LABEL=Cashier_1
KHQR_MOBILE=855XXXXXXXX
KHQR_MERCHANT_CATEGORY_CODE=5999

# Turn on only after you receive Bakong API access for live transaction status
USE_BAKONG_LIVE_STATUS=false
BAKONG_BASE_URL=
BAKONG_ACCESS_TOKEN=
